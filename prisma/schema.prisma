model categories {
  id         String   @id
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String
  posts      posts[]

  @@schema("henein")
}

model characters {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  name       String     @unique @default("")
  world      String
  class      String
  image      String?    @db.VarChar
  level      Int
  exp        String?    @db.VarChar
  exp_rate   String?
  stat       String?
  user_id    String?    @default(dbgenerated("auth.uid()")) @db.Uuid
  ocid       String     @unique
  users      users?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  profiles   profiles[]
  logs       logs[]
  streamer   streamer[]

  @@schema("henein")
}

model comments {
  id         BigInt     @id @default(autoincrement())
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at DateTime?  @db.Timestamptz(6)
  content    String
  author_id  String     @db.Uuid
  post_id    BigInt?
  parent_id  BigInt?
  users      users      @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent     comments?  @relation("CommentToReplies", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    comments[] @relation("CommentToReplies")
  posts      posts?     @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("henein")
}

model posts {
  id          BigInt     @id(map: "post_pkey") @default(autoincrement())
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime?  @db.Timestamptz(6)
  title       String
  content     Json
  author_id   String     @db.Uuid
  category_id String
  view_count  BigInt     @default(0)
  comments    comments[]
  likes       likes[]
  users       users      @relation(fields: [author_id], references: [id], onDelete: Cascade)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("henein")
}

model profiles {
  id               String      @id(map: "user_pkey") @db.Uuid
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @default(now()) @db.Timestamptz(6)
  nickname         String      @unique(map: "user_username_key") @default(dbgenerated("('guest'::text || nextval('guest_username_seq'::regclass))"))
  profile_img      String?
  nexon_key        String?     @unique
  master_character String?     @db.Uuid
  likes            likes[]
  characters       characters? @relation(fields: [master_character], references: [id], onDelete: Cascade)
  users            users       @relation(fields: [id], references: [id], onDelete: Cascade, map: "user_id_fkey")
  roles            roles?
  streamer         streamer[]

  @@schema("henein")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model streamer {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id           String                 @db.Uuid
  character_id         String?                @db.Uuid
  team                 mamudae_team
  nickname             String                 @unique
  order                Int                    @default(0)
  color                String?
  bosses               bosses[]
  daily_mission_prizes daily_mission_prizes[]
  characters           characters?            @relation(fields: [character_id], references: [id], onDelete: Cascade)
  profiles             profiles               @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@schema("mamudae")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notices {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  title      String   @default("")

  @@schema("henein")
}

model likes {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  user_id    String   @default(dbgenerated("auth.uid()")) @db.Uuid
  post_id    BigInt
  is_liked   Boolean
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  profiles   profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@schema("henein")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
